# ==============================================================================
# BIẾN MÔI TRƯỜNG DỰ ÁN "TRỢ LÝ KHO BẾP" (AI KITCHEN INVENTORY ASSISTANT)
# ==============================================================================
# Hướng dẫn: Sao chép file này thành .env ở thư mục gốc trước khi chạy docker compose.
# File này chứa các giá trị cấu hình mẫu an toàn, KHÔNG chứa secrets thật.

# 1. Cấu hình Dịch vụ AI (Google Gemini API)
# Lấy API key miễn phí tại: https://aistudio.google.com/app/apikey
# Nếu không cung cấp, hệ thống tự động chạy ở chế độ Rule-based Grounding dự phòng an toàn.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_BACKUP_VISION_MODEL=gemini-3.5-flash-lite

# 2. Cấu hình Cổng dịch vụ
PORT=3000
NODE_ENV=production

# 3. Cấu hình PostgreSQL Database (Dành cho Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_123
POSTGRES_DB=kitchen_inventory
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# 4. Cấu hình Bảo mật JWT Backend
JWT_SECRET=super_secret_jwt_key_change_in_production_123456
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=720

# 5. Môi trường Ứng dụng & CORS
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001","http://localhost:5173"]
ALLOW_DEMO_RESET=true
