# ==============================================================================
# BIẾN MÔI TRƯỜNG CHO BACKEND PYTHON FASTAPI & POSTGRESQL (CHẠY TRÊN VS CODE / DOCKER)
# ==============================================================================
# Hướng dẫn: Copy file này thành backend/.env khi chạy trên máy tính cá nhân.
# File này chứa các giá trị mẫu, KHÔNG chứa mật khẩu hay thông tin đăng nhập thật.

# 1. Cấu hình PostgreSQL Database (khi chạy qua docker-compose hoặc local PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_123
POSTGRES_DB=kitchen_inventory
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL kết nối cơ sở dữ liệu SQLAlchemy 2.x (Sync psycopg 3)
DATABASE_URL=postgresql+psycopg://postgres:postgres_password_123@localhost:5432/kitchen_inventory

# URL quản trị dành cho Migration & Reset scripts (Owner role)
ADMIN_DATABASE_URL=postgresql+psycopg://postgres:postgres_password_123@localhost:5432/kitchen_inventory

# 2. Cấu hình bảo mật JWT
JWT_SECRET=super_secret_jwt_key_change_in_production_123456
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=720

# Gemini Vision OCR (invoice scan)
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash

# 3. Môi trường ứng dụng
APP_ENV=development
ALLOW_DEMO_RESET=true

# 4. CORS Origins (cho phép Frontend React truy cập)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001","http://localhost:5173"]
